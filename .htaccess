# ==============================================================
# .htaccess — Visual Easy 3D (Otimizado 10/10)
# ==============================================================

# ----------------------------------------------------------------------
# Forçar HTTPS
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Força https caso ainda não esteja em HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ----------------------------------------------------------------------
# Redirecionamentos 301 (Consolidar SEO)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # /index.html -> /
    RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
    RewriteRule ^index\.html$ / [R=301,L]

    # /home.html -> /
    RewriteCond %{THE_REQUEST} \s/+home\.html[\s?] [NC]
    RewriteRule ^home\.html$ / [R=301,L]

    # Remover www (consolidar domínio)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# ----------------------------------------------------------------------
# Compressão Brotli/Gzip (deixa o site mais leve)
# ----------------------------------------------------------------------
# Brotli (se disponível no servidor)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css application/javascript application/json image/svg+xml image/x-icon application/xml application/xhtml+xml application/rss+xml application/atom+xml application/vnd.ms-fontobject font/opentype
</IfModule>

# Gzip (fallback comum)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml image/x-icon application/xml application/xhtml+xml application/rss+xml application/atom+xml application/vnd.ms-fontobject font/opentype
</IfModule>

# ----------------------------------------------------------------------
# Cache de Navegador (Acelera visitas recorrentes)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On

    # Default: 1 mês
    ExpiresDefault "access plus 1 month"

    # Imagens: 1 ano
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"

    # Fontes: 1 ano
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # CSS e JS: 1 mês
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # HTML: 1 hora (para atualizações rápidas)
    ExpiresByType text/html "access plus 1 hour"

    # JSON/XML: 1 dia
    ExpiresByType application/json "access plus 1 day"
    ExpiresByType application/xml "access plus 1 day"
</IfModule>

# Cache-Control para reforçar políticas
<IfModule mod_headers.c>
    # HTML: não cachear agressivamente
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    <FilesMatch "\.(png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# ----------------------------------------------------------------------
# Segurança — Headers Modernos (2026 Best Practices)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # X-Frame-Options: Previne Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Previne MIME sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # HSTS: Força HTTPS em navegadores (1 ano, com subdomínios, preload)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    
    # Referrer Policy: Protege dados de referência
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Permissions Policy: Desabilita APIs não utilizadas
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"
    
    # X-XSS-Protection (legacy, mas ainda útil para IE)
    Header always set X-XSS-Protection "1; mode=block"
    
    # Content Security Policy (CSP) — Restritiva mas funcional
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://cdn.jsdelivr.net https://www.googletagmanager.com https://www.google-analytics.com https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src https://tour360.meupasseiovirtual.com; connect-src 'self' https://www.google-analytics.com https://script.google.com https://www.googletagmanager.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self' https://script.google.com;"
    
    # Remove assinatura do servidor
    ServerSignature Off
    Header unset X-Powered-By
    Header unset Server
</IfModule>

# ----------------------------------------------------------------------
# Proteções extras
# ----------------------------------------------------------------------
# Bloqueia listagem de diretórios
Options -Indexes

# Bloqueia acesso a arquivos ocultos (.git, .env, etc.)
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protege arquivos sensíveis
<FilesMatch "\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|sw[op])$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# ----------------------------------------------------------------------
# Performance: ETags (Consistência de cache)
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header unset ETag
</IfModule>
FileETag None

# ----------------------------------------------------------------------
# Prevenção de Hotlinking (protege imagens e vídeos)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?visualeasy\.com\.br [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?google\. [NC]
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?bing\. [NC]
    RewriteRule \.(jpg|jpeg|png|gif|webp|svg|mp4|webm)$ - [F,L]
</IfModule>

# ----------------------------------------------------------------------
# Tipos MIME corretos
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
</IfModule>
